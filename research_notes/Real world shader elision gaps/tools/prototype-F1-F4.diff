+/// F3 prototype: interval rules for more binary operators. `known_*` says whether the
+/// operand had a real (non-default full) range; add/sub/mul keep the original
+/// requirement that both operands are known.
+fn proto_binary(op: BinaryOperator, l: IntRange, r: IntRange, known_l: bool, known_r: bool) -> Option<IntRange> {
+    use IntRange::{I32, U32};
+    match op {
+        BinaryOperator::Add if known_l && known_r => l.add(r),
+        BinaryOperator::Subtract if known_l && known_r => l.sub(r),
+        BinaryOperator::Multiply if known_l && known_r => l.mul(r),
+        BinaryOperator::Divide => match (l, r) {
+            (U32 { min: a, max: b }, U32 { min: c, max: d }) if c > 0 => Some(U32 { min: a / d, max: b / c }),
+            (I32 { min: a, max: b }, I32 { min: c, max: d }) if a >= 0 && c > 0 => Some(I32 { min: a / d, max: b / c }),
+            _ => None,
+        },
+        BinaryOperator::Modulo => {
+            let k = r.exact()?;
+            if k <= 0 {
+                return None;
+            }
+            match l {
+                U32 { min: a, max: b } => {
+                    let k = u32::try_from(k).ok()?;
+                    if a / k == b / k { Some(U32 { min: a % k, max: b % k }) } else { Some(U32 { min: 0, max: k - 1 }) }
+                }
+                I32 { min: a, max: b } if a >= 0 => {
+                    let k = i32::try_from(k).ok()?;
+                    if a / k == b / k { Some(I32 { min: a % k, max: b % k }) } else { Some(I32 { min: 0, max: k - 1 }) }
+                }
+                _ => None,
+            }
+        }
+        BinaryOperator::ShiftRight => {
+            let (c, d) = match r { U32 { min, max } if max < 32 => (min, max), _ => return None };
+            match l {
+                U32 { min: a, max: b } => Some(U32 { min: a >> d, max: b >> c }),
+                I32 { min: a, max: b } if a >= 0 => Some(I32 { min: a >> d, max: b >> c }),
+                _ => None,
+            }
+        }
+        BinaryOperator::ShiftLeft if known_l => {
+            let (c, d) = match r { U32 { min, max } if max < 32 => (min, max), _ => return None };
+            match l {
+                U32 { min: a, max: b } => {
+                    let hi = u64::from(b) << d;
+                    (hi <= u64::from(u32::MAX)).then(|| U32 { min: a << c, max: hi as u32 })
+                }
+                I32 { min: a, max: b } if a >= 0 => {
+                    let hi = i64::from(b) << d;
+                    (hi <= i64::from(i32::MAX)).then(|| I32 { min: a << c, max: hi as i32 })
+                }
+                _ => None,
+            }
+        }
+        BinaryOperator::And => match (l, r) {
+            (U32 { max: b, .. }, U32 { max: d, .. }) => Some(U32 { min: 0, max: b.min(d) }),
+            (I32 { min: a, max: b }, I32 { min: c, max: d }) if a >= 0 || c >= 0 => {
+                let hi = match (a >= 0, c >= 0) { (true, true) => b.min(d), (true, false) => b, _ => d };
+                Some(I32 { min: 0, max: hi })
+            }
+            _ => None,
+        },
+        _ => None,
+    }
