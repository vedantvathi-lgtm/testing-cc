== 01_decrement_signed.wgsl
var<workgroup> t: array<f32, 32>;
@compute @workgroup_size(1)
fn main() {
    for (var i = 31i; i >= 0i; i--) { t[i] = 1.0; }
}
== 02_decrement_unsigned_eq0.wgsl
var<workgroup> t: array<f32, 32>;
@compute @workgroup_size(1)
fn main() {
    var i = 32u; loop { if (i == 0u) { break; } i = i - 1u; t[i] = 1.0; }
}
