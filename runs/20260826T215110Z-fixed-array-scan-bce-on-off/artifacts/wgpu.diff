+            _ => return None,
+        };
+        let min = start.checked_sub(iterations.checked_sub(1)?.checked_mul(magnitude)?)?;
+        let exit = start.checked_sub(iterations.checked_mul(magnitude)?)?;
+        (min, start, exit)
+    } else {
+        return None;
+    };
+    Some((
